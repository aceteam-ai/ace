{
  "name": "@aceteam/ace",
  "version": "0.3.0",
  "description": "AceTeam CLI - Run AI workflows locally",
  "type": "module",
  "bin": {
    "ace": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "bash scripts/e2e.sh"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.267",
    "@inquirer/prompts": "7.10.1",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "ink": "5.2.1",
    "ora": "^8.0.0",
    "react": "18.3.1",
    "strip-ansi": "7.1.2",
    "which": "^4.0.0",
    "wrap-ansi": "9.0.2",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "18.3.24",
    "@types/which": "^3.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "ink-testing-library": "4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.4"
  },
  "license": "LicenseRef-Elastic-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/aceteam-ai/ace.git"
  },
  "keywords": [
    "aceteam",
    "ai",
    "workflow",
    "cli"
  ]
}
